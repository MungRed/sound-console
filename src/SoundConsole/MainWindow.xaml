<Window x:Class="SoundConsole.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SoundConsole.Controls"
        xmlns:converters="clr-namespace:SoundConsole.Converters"
        Title="声卡控制台 · Signal Desk"
        Width="1240" Height="880" MinWidth="1080" MinHeight="840"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <Style x:Key="StatusPill" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#131C22" />
            <Setter Property="BorderBrush" Value="#273842" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter Property="Background" Value="#12261F" />
                    <Setter Property="BorderBrush" Value="#2C6652" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Starting">
                    <Setter Property="Background" Value="#272414" />
                    <Setter Property="BorderBrush" Value="#66562A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Stopping">
                    <Setter Property="Background" Value="#272414" />
                    <Setter Property="BorderBrush" Value="#66562A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Faulted">
                    <Setter Property="Background" Value="#2B1719" />
                    <Setter Property="BorderBrush" Value="#6D3439" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusPillDot" TargetType="{x:Type Ellipse}">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="#758894" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Starting">
                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Stopping">
                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Faulted">
                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusPillText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Faulted">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OutputRow" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#0C141A" />
            <Setter Property="BorderBrush" Value="#1B2832" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter Property="Background" Value="#101E24" />
                    <Setter Property="BorderBrush" Value="#2A4A43" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#385347" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ToggleRouteCommand}" />
    </Window.InputBindings>

    <Border BorderBrush="#1E2A33" BorderThickness="1" Background="{StaticResource BackgroundBrush}">
        <Grid x:Name="RootGrid" ClipToBounds="True">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0B1117" Offset="0" />
                    <GradientStop Color="#090D12" Offset="0.55" />
                    <GradientStop Color="#070B0F" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <Ellipse Width="720" Height="540" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-280,-220,0" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1F2C8B6E" Offset="0" />
                        <GradientStop Color="#002C8B6E" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="560" Height="420" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-260,0,0,-260" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#14174A5E" Offset="0" />
                        <GradientStop Color="#00174A5E" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="36" />
                </Grid.RowDefinitions>

                <!-- Custom title bar -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="9" ClipToBounds="True" BorderBrush="#2A3A45" BorderThickness="1">
                            <Image Source="Assets/logo.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="声卡控制台" FontSize="14.5" FontWeight="SemiBold" />
                            <TextBlock Text="SIGNAL DESK" Style="{StaticResource MicroLabel}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                        <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource StatusPillDot}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusPillText}" Margin="7,0,0,0" />
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}"
                                ToolTip="刷新音频设备  (F5)" AutomationProperties.Name="刷新音频设备">
                            <TextBlock Text="⟳" FontFamily="Segoe UI Symbol" FontSize="17" HorizontalAlignment="Center" />
                        </Button>
                        <Border Width="1" Height="18" Background="#22313B" Margin="10,0,6,0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="最小化" AutomationProperties.Name="最小化">
                            <Path Data="M 1,6 L 11,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" Width="12" Height="12" Stretch="None" HorizontalAlignment="Center" />
                        </Button>
                        <Button Style="{StaticResource WindowButton}" Click="Maximize_Click" ToolTip="最大化" AutomationProperties.Name="最大化">
                            <Grid Width="12" Height="12">
                                <Path x:Name="MaximizeGlyph" Data="M 1,1 L 11,1 L 11,11 L 1,11 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.1" Fill="Transparent" />
                                <Path x:Name="RestoreGlyph" Data="M 3,1 L 11,1 L 11,9 M 1,3 L 9,3 L 9,11 L 1,11 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.1" Fill="Transparent" Visibility="Collapsed" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource CloseWindowButton}" Click="Close_Click" ToolTip="关闭" AutomationProperties.Name="关闭">
                            <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.25" Width="12" Height="12" Stretch="None" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Main content -->
                <Grid Grid.Row="1" Margin="22,10,22,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="372" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Input card -->
                        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,17">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="3" Height="17" CornerRadius="2" Background="#63B3ED" VerticalAlignment="Center" />
                                        <TextBlock Text="输入源" Style="{StaticResource CardTitle}" Margin="9,0,0,0" />
                                        <TextBlock Text="INPUT" Style="{StaticResource MicroLabel}" Margin="8,3,0,0" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Style="{StaticResource AccentTagBorder}"
                                            ToolTip="{Binding InputTip}">
                                        <TextBlock Text="{Binding InputTag}" Style="{StaticResource AccentTagText}" />
                                    </Border>
                                </Grid>

                                <TextBlock Text="输入设备" Style="{StaticResource FieldLabel}" Margin="1,15,0,6" />
                                <ComboBox Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding InputDevices}"
                                          SelectedItem="{Binding SelectedInput, Mode=TwoWay}"
                                          IsEnabled="{Binding CanEditRouting}"
                                          ToolTip="{Binding InputTip}"
                                          AutomationProperties.Name="输入设备">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding FormatSummary}" FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}" Margin="12,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{Binding InputMeta}" Style="{StaticResource SmallText}" Margin="1,6,0,0"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />

                                <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowChannelSelector, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <TextBlock Text="输入声道" Style="{StaticResource FieldLabel}" Margin="1,0,0,6" />
                                        <TextBlock Text="?" FontSize="9" Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Right" Margin="0,1,2,0" ToolTip="{Binding InputChannelHint}"
                                                   Cursor="Help" />
                                    </Grid>
                                    <ComboBox Style="{StaticResource DarkComboBox}" Height="38"
                                              ItemsSource="{Binding InputChannels}"
                                              SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                                              IsEnabled="{Binding CanEditRouting}"
                                              ToolTip="{Binding InputChannelHint}"
                                              AutomationProperties.Name="输入声道"
                                              DisplayMemberPath="Label" />
                                </StackPanel>

                                <Grid Margin="0,11,0,0">
                                    <TextBlock Text="输入增益" Style="{StaticResource FieldLabel}" Margin="1,0,0,0" />
                                    <TextBlock Text="{Binding InputGainText}" Style="{StaticResource MonoText}" FontSize="11"
                                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Style="{StaticResource DarkSlider}" Minimum="-24" Maximum="12"
                                        TickFrequency="0.5" IsSnapToTickEnabled="True"
                                        Value="{Binding InputGainDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="输入增益：只影响路由到电脑的音量，不改变效果器内部音量"
                                        AutomationProperties.Name="输入增益" />

                                <Border Height="1" Background="#1B2832" Margin="0,12,0,12" />

                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="输入电平" Style="{StaticResource FieldLabel}" Margin="1,0,0,0" />
                                        <TextBlock Text="dBFS" Style="{StaticResource MicroLabel}" Margin="7,2,0,0" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Style="{StaticResource DangerTagBorder}" Padding="5,2"
                                            Visibility="{Binding InputMeter.Clipped, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="CLIP" Style="{StaticResource DangerTagText}" FontSize="9" />
                                    </Border>
                                </Grid>

                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="15" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="L" Style="{StaticResource MicroLabel}" VerticalAlignment="Center" />
                                    <controls:LevelMeter Grid.Column="1" Height="9" Level="{Binding InputMeter.LeftLevel}"
                                                         Peak="{Binding InputMeter.LeftPeak}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding InputMeter.LeftText}" Style="{StaticResource MonoText}"
                                               FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="15" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="R" Style="{StaticResource MicroLabel}" VerticalAlignment="Center" />
                                    <controls:LevelMeter Grid.Column="1" Height="9" Level="{Binding InputMeter.RightLevel}"
                                                         Peak="{Binding InputMeter.RightPeak}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding InputMeter.RightText}" Style="{StaticResource MonoText}"
                                               FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Monitor / start card -->
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,17">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="3" Height="17" CornerRadius="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="监听设置" Style="{StaticResource CardTitle}" Margin="9,0,0,0" />
                                            <TextBlock Text="OUTPUT" Style="{StaticResource MicroLabel}" Margin="8,3,0,0" />
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" Style="{StaticResource TagBorder}">
                                            <TextBlock Text="{Binding ModeText}" Style="{StaticResource TagText}" />
                                        </Border>
                                    </Grid>

                                    <Grid Margin="1,13,1,5">
                                        <TextBlock Text="安全缓冲" Style="{StaticResource FieldLabel}" Margin="0" />
                                        <TextBlock Text="{Binding LatencyEstimateText}" Style="{StaticResource MicroLabel}"
                                                   FontSize="9" HorizontalAlignment="Right" Margin="0,1,0,0"
                                                   ToolTip="{Binding LatencyHint}" />
                                    </Grid>
                                    <ComboBox Style="{StaticResource DarkComboBox}" Height="40"
                                              ItemsSource="{Binding BufferOptions}"
                                              SelectedItem="{Binding SelectedBuffer, Mode=TwoWay}"
                                              IsEnabled="{Binding CanEditRouting}"
                                              DisplayMemberPath="Label"
                                              ToolTip="{Binding LatencyHint}"
                                              AutomationProperties.Name="安全缓冲"
                                              AutomationProperties.HelpText="{Binding LatencyHint}" />
                                    <TextBlock Text="{Binding SelectedBuffer.Description}" Style="{StaticResource SmallText}"
                                               Margin="1,4,0,0" FontSize="10.5" />

                                    <Border Style="{StaticResource InnerCard}" Margin="0,12,0,0" Padding="11,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="独占输出" FontSize="12" FontWeight="SemiBold" />
                                                    <TextBlock Text="EXCLUSIVE" Style="{StaticResource MicroLabel}" Margin="6,2,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="绕过系统混音以降低延迟，可能阻止其他程序播放"
                                                           Style="{StaticResource SmallText}" FontSize="10" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                                      IsChecked="{Binding PreferExclusive, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanEditRouting}"
                                                      ToolTip="设备不支持独占时会自动回退到共享模式"
                                                      AutomationProperties.Name="独占输出" />
                                        </Grid>
                                    </Border>

                                    <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="7"
                                            Background="#0B1419" BorderBrush="#1C2B34" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="13" Height="13" CornerRadius="7" BorderBrush="#3A5D67"
                                                    BorderThickness="1" VerticalAlignment="Top" Margin="0,2,0,0">
                                                <TextBlock Text="i" FontSize="8.5" FontWeight="Bold" Foreground="#7FB7C8"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding InputTip}" Style="{StaticResource SmallText}"
                                                       FontSize="10" Margin="6,0,0,0" LineHeight="16" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="2">
                                    <Button Style="{StaticResource StartButton}" Command="{Binding ToggleRouteCommand}"
                                            ToolTip="开始或停止音频路由（Ctrl + Enter）"
                                            AutomationProperties.Name="开始或停止音频路由">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Path Data="M 0,0 L 0,11 L 9,5.5 Z"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Stretch="Fill">
                                                    <Path.Style>
                                                        <Style TargetType="{x:Type Path}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <Path Data="M 0,0 L 10,0 L 10,10 L 0,10 Z"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Stretch="Fill">
                                                    <Path.Style>
                                                        <Style TargetType="{x:Type Path}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Grid>
                                            <TextBlock Text="{Binding StartButtonText}" FontSize="15" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Route overview -->
                        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,17">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="3" Height="17" CornerRadius="2" Background="#63B3ED" VerticalAlignment="Center" />
                                        <TextBlock Text="路由概览" Style="{StaticResource CardTitle}" Margin="9,0,0,0" />
                                        <TextBlock Text="SIGNAL FLOW" Style="{StaticResource MicroLabel}" Margin="8,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource StatusPillDot}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource InnerCard}" Padding="11,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="15" Background="#142731" VerticalAlignment="Center">
                                                <Path Data="M 2,8 C 5,2 8,14 11,8 C 13,4 15,10 18,8"
                                                      Stroke="#63B3ED" StrokeThickness="1.6" Width="18" Height="16"
                                                      Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedInput.DisplayName, TargetNullValue=未选择输入}"
                                                           FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding SelectedInput.RawName}" />
                                                <TextBlock Text="{Binding InputFormatText}" Style="{StaticResource SmallText}"
                                                           FontSize="10" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Column="1" VerticalAlignment="Center" Height="30">
                                        <Rectangle Height="1" Fill="#2A3C47" VerticalAlignment="Center" />
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#101A20"
                                                BorderBrush="#2A3C47" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M 4,8 L 10,8 M 7,5 L 10,8 L 7,11"
                                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.4"
                                                  Width="13" Height="13" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Border>
                                    </Grid>

                                    <Border Grid.Column="2" Style="{StaticResource InnerCard}" Padding="11,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="15" Background="#17251F" VerticalAlignment="Center">
                                                <Path Data="M 3,8 L 3,13 L 6,13 L 10,16 L 10,5 L 6,8 Z M 13,7 C 15,9 15,12 13,14"
                                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1.4" Width="17" Height="16"
                                                      Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedOutputsSummary}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding SelectedOutputsSummary}" />
                                                <TextBlock Text="{Binding OutputCountText}" Style="{StaticResource SmallText}"
                                                           FontSize="10" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Border Height="1" Background="#1B2832" Margin="0,13,0,11" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="输入格式" Style="{StaticResource MicroLabel}" />
                                        <TextBlock Text="{Binding InputFormatText}" Style="{StaticResource MonoText}" FontSize="11.5" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#1B2832" Margin="0,1,0,1" />
                                    <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                        <TextBlock Text="安全缓冲" Style="{StaticResource MicroLabel}" />
                                        <TextBlock Text="{Binding SelectedBufferMsText}" Style="{StaticResource MonoText}" FontSize="11.5" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="3" Background="#1B2832" Margin="0,1,0,1" />
                                    <StackPanel Grid.Column="4" Margin="16,0,0,0">
                                        <TextBlock Text="运行时长" Style="{StaticResource MicroLabel}" />
                                        <TextBlock Text="{Binding SessionText}" Style="{StaticResource MonoText}" FontSize="11.5" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Border Margin="0,12,0,0" Padding="10,7" CornerRadius="7" Background="#111F1A"
                                        BorderBrush="#244437" BorderThickness="1"
                                        Visibility="{Binding HasStatusNote, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding StatusNote}" Style="{StaticResource SmallText}" FontSize="10.5"
                                                   Margin="7,0,0,0" Foreground="#A7C9BB" TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" ToolTip="{Binding StatusNote}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Output devices -->
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="1,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="3" Height="17" CornerRadius="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="输出设备" Style="{StaticResource CardTitle}" Margin="9,0,0,0" />
                                            <TextBlock Text="OUTPUTS" Style="{StaticResource MicroLabel}" Margin="8,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding OutputHelpText}" Style="{StaticResource SmallText}" Margin="12,4,0,0" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource TagBorder}">
                                        <TextBlock Text="{Binding OutputCountText}" Style="{StaticResource TagText}" />
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
                                        <ItemsControl ItemsSource="{Binding OutputDevices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource OutputRow}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="42" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <CheckBox Grid.RowSpan="2" Style="{StaticResource Switch}" VerticalAlignment="Top"
                                                                      Margin="0,2,0,0"
                                                                      IsChecked="{Binding Selected, Mode=TwoWay}"
                                                                      IsEnabled="{Binding DataContext.CanEditRouting, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      ToolTip="启用此输出（运行中不可更改）"
                                                                      AutomationProperties.Name="{Binding Name, StringFormat=启用输出 {0}}" />

                                                            <Grid Grid.Column="1" Grid.Row="0" Margin="0,0,14,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                               ToolTip="{Binding RawName}" />
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                                                        <Border Style="{StaticResource TagBorder}" Padding="6,2">
                                                                            <TextBlock Text="{Binding Tag}" Style="{StaticResource TagText}" />
                                                                        </Border>
                                                                        <Border Style="{StaticResource TagBorder}" Padding="6,2" Margin="5,0,0,0"
                                                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}">
                                                                            <TextBlock Text="默认" Style="{StaticResource AccentTagText}" />
                                                                        </Border>
                                                                        <Border Style="{StaticResource DangerTagBorder}" Padding="6,2" Margin="5,0,0,0"
                                                                                Visibility="{Binding IsAmpero, Converter={StaticResource BoolToVisibility}}"
                                                                                ToolTip="这是效果器的 USB 回传输出，选中后可能形成回环啸叫">
                                                                            <TextBlock Text="回传风险" Style="{StaticResource DangerTagText}" />
                                                                        </Border>
                                                                    </StackPanel>
                                                                </Grid>
                                                                <TextBlock Grid.Row="1" Text="{Binding DetailLine}" Style="{StaticResource SmallText}"
                                                                           FontSize="10" Margin="0,3,0,0" TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Grid>

                                                            <StackPanel Grid.Column="2" Grid.Row="0" VerticalAlignment="Center" Width="86">
                                                                <controls:LevelMeter Height="5" Level="{Binding Meter.LeftLevel}"
                                                                                     Peak="{Binding Meter.LeftPeak}" />
                                                                <controls:LevelMeter Height="5" Margin="0,3,0,0" Level="{Binding Meter.RightLevel}"
                                                                                     Peak="{Binding Meter.RightPeak}" />
                                                            </StackPanel>

                                                            <Grid Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,8,0,0"
                                                                  Visibility="{Binding Selected, Converter={StaticResource BoolToVisibility}}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="28" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="66" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="VOL" Style="{StaticResource MicroLabel}" FontSize="8.5"
                                                                           VerticalAlignment="Center" />
                                                                <Slider Grid.Column="1" Style="{StaticResource DarkSlider}" Minimum="-60" Maximum="0"
                                                                        TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                                        Value="{Binding VolumeDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                        IsEnabled="{Binding Selected}"
                                                                        ToolTip="此输出的音量（仅作用于本软件的路由）"
                                                                        AutomationProperties.Name="输出音量" />
                                                                <TextBlock Grid.Column="2" Text="{Binding VolumeText}" Style="{StaticResource MonoText}"
                                                                           FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                <ToggleButton Grid.Column="3" Style="{StaticResource MuteToggle}" Margin="7,0,0,0"
                                                                              IsChecked="{Binding Muted, Mode=TwoWay}"
                                                                              IsEnabled="{Binding Selected}"
                                                                              ToolTip="静音此输出"
                                                                              AutomationProperties.Name="{Binding Name, StringFormat=静音 {0}}" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <Border Background="#0C141A" BorderBrush="#1B2832" BorderThickness="1" CornerRadius="10"
                                            Padding="24" VerticalAlignment="Top"
                                            Visibility="{Binding HasOutputDevices, Converter={StaticResource InverseBoolToVisibility}}">
                                        <StackPanel HorizontalAlignment="Center" Margin="0,26">
                                            <Border Width="44" Height="44" CornerRadius="22" Background="#13212A" HorizontalAlignment="Center">
                                                <Path Data="M 5,12 L 5,18 L 9,18 L 14,22 L 14,8 L 9,12 Z M 18,10 C 20,13 20,17 18,20"
                                                      Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.4" Width="20" Height="20"
                                                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Border>
                                            <TextBlock Text="没有找到输出设备" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                                            <TextBlock Text="连接耳机、音箱或 DAC 后，点击右上角刷新" Style="{StaticResource SmallText}"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Footer -->
                <Grid Grid.Row="2" Margin="24,0" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Style="{StaticResource StatusPillDot}" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding StatusDetail}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DropoutText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,12,0"
                                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        <Border Width="1" Height="12" Background="#22303A" Margin="0,0,10,0" />
                        <TextBlock Text="WASAPI" Style="{StaticResource MicroLabel}" VerticalAlignment="Center" Margin="0,0,3,0" />
                        <Button Style="{StaticResource LinkButton}" Content="日志" Command="{Binding OpenLogsCommand}"
                                ToolTip="打开日志目录" Margin="4,0,0,0" />
                        <Button Style="{StaticResource LinkButton}" Content="数据目录" Command="{Binding OpenDataFolderCommand}"
                                ToolTip="打开设置和日志目录" Margin="2,0,0,0" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource MicroLabel}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Error toast -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,26,50" MaxWidth="560"
                    Background="#241518" BorderBrush="#6A3338" BorderThickness="1" CornerRadius="11"
                    Padding="14,12" Panel.ZIndex="20">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="5" Opacity="0.45" />
                </Border.Effect>
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <Border Width="22" Height="22" CornerRadius="11" Background="#4A2227" VerticalAlignment="Top">
                        <TextBlock Text="!" FontWeight="Bold" FontSize="12" Foreground="#FFB1AE"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="4,0,8,0">
                        <TextBlock Text="操作未完成" FontSize="12" FontWeight="SemiBold" Foreground="#FFD9D7" />
                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource SmallText}" Foreground="#D8A9A7"
                                   FontSize="10.5" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="26"
                            Command="{Binding DismissErrorCommand}" ToolTip="关闭提示"
                            HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Path Data="M 1,1 L 8,8 M 8,1 L 1,8" Stroke="{StaticResource TextMutedBrush}"
                              StrokeThickness="1.2" Width="9" Height="9" Stretch="None" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
